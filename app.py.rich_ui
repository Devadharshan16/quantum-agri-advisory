    with col_insights:
        optimal_str = "<br>".join([f"✓ {x}" for x in optimal_params]) if optimal_params else "None"
        attention_str = "<br>".join([f"⚠ {x}" for x in attention_params]) if attention_params else "None"
        
        html_insights = f"""
